<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.employeemgtsystem.controllers.EmployeeDialogController"
            stylesheets="../design.css">

    <header>
        <Label fx:id="dialogTitle" text="Employee Details" styleClass="dialog-title"/>
    </header>

    <content>
        <GridPane hgap="10" vgap="10" style="-fx-padding: 20;">
            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Department:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="deptField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Salary:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="salaryField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Performance Rating (0-5):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="ratingField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Years of Experience:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="expField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Status:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <CheckBox fx:id="activeField" text="Active" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>
    </content>

    <!-- Replace the buttonTypes section with: -->
    <buttonTypes>
        <ButtonType fx:id="saveButtonType" text="Save" buttonData="OK_DONE"/>
        <ButtonType fx:id="cancelButtonType" text="Cancel" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>